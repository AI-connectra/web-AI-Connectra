  <header>
    <div class="container header-inner">
      <div class="brand-cluster" onclick="navigateToSubjects()">
        <div class="brand-logo-container">
          <img src="data:image/png;base64," alt="AI Connectra Official Logo" class="brand-logo-img">
        </div>
        <div class="brand-text-block">
          <span class="brand-title">AI CONNECTRA</span>
          <span class="brand-tagline">Where AI Meets Every Discipline</span>
        </div>
      </div>

      <div class="nav-actions">
        <button class="nav-pill-btn btn-course-nav" onclick="openCourseView('ml')">
          <span>🎓 Flagship Courses</span>
        </button>
        <button class="nav-pill-btn" onclick="openCompareTracksView()">
          <span>💎 Free vs Paid</span>
        </button>
        <button class="nav-pill-btn" onclick="openDisciplineRelevanceView('eee')">
          <span>🧭 By Discipline</span>
        </button>
        <button class="nav-pill-btn" onclick="scrollToSubjects()">
          <span style="color: #9B1C1C;">⚡ 200 Blueprints</span>
        </button>
        <button class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
          <span>🌙</span>
        </button>
      </div>
    </div>
  </header>
